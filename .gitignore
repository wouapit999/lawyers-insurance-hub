# ---------------------------------------------------------------------------
# Lawyers Insurance Hub
#
# The secrets section is first and deliberately broad. This platform holds
# national ID numbers, payment credentials and a signing key that mints
# sessions for every member of the Bar. A leaked .env is a reportable
# incident, so anything that smells like a credential is excluded by default
# and added back explicitly.
# ---------------------------------------------------------------------------

# --- secrets and credentials ------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.cer
*.certSigningRequest
secrets.yaml
!infrastructure/kubernetes/secrets.example.yaml
**/serviceAccountKey.json
**/google-services.json
**/GoogleService-Info.plist
.azure/
kubeconfig*

# --- dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/

# --- build output -----------------------------------------------------------
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
coverage/
.nyc_output/

# --- Flutter / mobile -------------------------------------------------------
mobile-app/.dart_tool/
mobile-app/.flutter-plugins
mobile-app/.flutter-plugins-dependencies
mobile-app/.packages
mobile-app/build/
mobile-app/ios/Pods/
mobile-app/ios/.symlinks/
mobile-app/ios/Flutter/Flutter.framework
mobile-app/ios/Flutter/Generated.xcconfig
mobile-app/android/.gradle/
mobile-app/android/local.properties
mobile-app/android/key.properties
*.apk
*.aab
*.ipa
*.app.zip

# --- Electron / desktop -----------------------------------------------------
desktop-app/dist/
desktop-app/release/
*.dmg
*.exe
*.msi
*.AppImage
*.deb
*.snap

# --- databases and storage --------------------------------------------------
*.sqlite
*.sqlite3
*.db
storage/
uploads/
pgdata/

# --- logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
logs/

# --- editors and OS ---------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# --- Terraform --------------------------------------------------------------
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
crash.log

# --- misc -------------------------------------------------------------------
tmp/
temp/
.cache/

# tsc output that lands beside sources when a build is run without -p
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
