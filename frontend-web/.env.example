# ===========================================================================
# Lawyers Insurance Hub — web application
#
# Everything prefixed NEXT_PUBLIC_ is embedded in the JavaScript bundle and is
# readable by anyone who opens dev tools. Never put a secret behind that
# prefix. Server-only values (no prefix) stay on the Vercel function.
#
# In Vercel these are set per environment under
# Settings → Environment Variables, scoped to Production / Preview /
# Development. Do not upload a .env file.
# ===========================================================================

# --- API -------------------------------------------------------------------
# Production: https://api.lih.cm/v1
# Staging:    https://staging.api.lih.cm/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# --- Localisation ----------------------------------------------------------
# French is the default. Both locales are always available; this only decides
# where a bare "/" redirects.
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPPORTED_LOCALES=fr,en

# --- Branding --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Lawyers Insurance Hub"
NEXT_PUBLIC_SUPPORT_EMAIL=support@lih.cm
NEXT_PUBLIC_SUPPORT_PHONE=+237670000000

# --- Payment return --------------------------------------------------------
# Where CinetPay and Orange Money send the customer's browser back to after
# checkout. Must match what the backend sends as PAYMENT_RETURN_URL.
NEXT_PUBLIC_PAYMENT_RETURN_PATH=/payments/return

# --- Feature flags ---------------------------------------------------------
# Phase 2 features, off until their backends exist. Turning one on before the
# API supports it produces a working button that fails.
NEXT_PUBLIC_FEATURE_CARD_PAYMENTS=false
NEXT_PUBLIC_FEATURE_LIVE_CHAT=false
NEXT_PUBLIC_FEATURE_AI_ASSISTANT=false
NEXT_PUBLIC_FEATURE_DOCUMENT_SEARCH=false

# --- Analytics -------------------------------------------------------------
NEXT_PUBLIC_APPLICATIONINSIGHTS_CONNECTION_STRING=
NEXT_TELEMETRY_DISABLED=1

# ===========================================================================
# SERVER-ONLY (no NEXT_PUBLIC_ prefix — never sent to the browser)
# ===========================================================================
# Used by Next.js route handlers that call the API server-to-server.
API_INTERNAL_URL=http://localhost:3000/v1

# Signs the session cookie for the server-rendered pages.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
