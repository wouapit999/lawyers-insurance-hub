# ===========================================================================
# Lawyers Insurance Hub — backend environment
#
# Copy to .env and fill in. NEVER commit a filled-in copy.
# In every deployed environment these come from Azure Key Vault through the
# Secrets Store CSI driver, not from a file.
#
# Generate the three cryptographic values with:
#   node -e "const c=require('crypto');\
#     console.log('JWT_ACCESS_SECRET='+c.randomBytes(48).toString('base64'));\
#     console.log('JWT_REFRESH_SECRET='+c.randomBytes(48).toString('base64'));\
#     console.log('PII_ENCRYPTION_KEY='+c.randomBytes(32).toString('base64'))"
# ===========================================================================

NODE_ENV=development
PORT=3000
API_PREFIX=v1
DEFAULT_LOCALE=fr                    # fr | en — French is the default in Cameroon

# --- Database --------------------------------------------------------------
# sslmode=require in every deployed environment. The database holds encrypted
# national ID numbers; an unencrypted hop is not acceptable.
DATABASE_URL=postgresql://lih:lih_dev_password@localhost:5432/lih?schema=public

# --- Redis -----------------------------------------------------------------
# Sessions, OTP codes, rate-limit counters, quote drafts, notification dedupe.
# Azure Cache for Redis uses rediss:// on port 6380.
REDIS_URL=redis://localhost:6379

# --- JWT -------------------------------------------------------------------
# Both must be at least 32 characters — the app refuses to boot otherwise,
# because a short HS256 key is brute-forceable offline.
# The two must DIFFER: reusing one key means a refresh token would validate as
# an access token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- PII encryption --------------------------------------------------------
# AES-256-GCM key for national ID numbers, passport numbers and MFA secrets.
# Must decode to EXACTLY 32 bytes. Required in production; without it the app
# refuses to start rather than silently storing identity numbers in plaintext.
#
# If this key is lost, every encrypted value is permanently unreadable. It
# lives in Key Vault with purge protection enabled.
PII_ENCRYPTION_KEY=

# ===========================================================================
# PAYMENTS
#
# Every rail is optional in development — the adapters fall back to a
# simulator when unset, so the whole checkout flow is testable end to end
# without provider sandboxes.
# ===========================================================================

# --- Orange Money Cameroon -------------------------------------------------
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/cm/v1
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

# --- MTN Mobile Money ------------------------------------------------------
# Sandbox: https://sandbox.momodeveloper.mtn.com  (target env "sandbox")
# Live:    https://proxy.momoapi.mtn.com          (target env "mtncameroon")
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_WEBHOOK_SECRET=

# --- Cards: Visa / Mastercard ----------------------------------------------
# CinetPay is the aggregator. Card data never reaches our servers — the
# customer enters it on CinetPay's hosted page and we store a token, which
# keeps the PCI-DSS burden with the aggregator (SAQ-A rather than a full
# audit of our infrastructure).
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_WEBHOOK_SECRET=

# --- Stripe ----------------------------------------------------------------
# NOT USED IN PRODUCTION. Stripe does not support merchants or payouts in
# Cameroon, which is why CinetPay handles cards. Kept here only for a possible
# future non-CEMAC tenant under the Phase 3 multi-tenant work. Leave blank.
STRIPE_API_KEY=

# --- Payment callbacks -----------------------------------------------------
# Must be publicly reachable and HTTPS in any deployed environment. For local
# webhook testing, tunnel with: npx localtunnel --port 3000
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000/v1/payments/webhooks
PAYMENT_CALLBACK_URL=http://localhost:3000/v1/payments/webhooks
PAYMENT_RETURN_URL=http://localhost:3001/fr/payments/return

# ===========================================================================
# DEPLOYMENT TARGET  —  the switches that make this portable
#
# The application never branches on these in business logic. They select
# infrastructure adapters at boot, so moving from the free stack to Azure is
# a change to these values plus credentials, and nothing else.
#
#   DEPLOY_TARGET=local     STORAGE_DRIVER=local      (development)
#   DEPLOY_TARGET=render    STORAGE_DRIVER=supabase   (free tier, no card)
#   DEPLOY_TARGET=azure     STORAGE_DRIVER=azure_blob (production)
# ===========================================================================

DEPLOY_TARGET=local
STORAGE_DRIVER=local
TELEMETRY_DRIVER=none

# Public base URL of this API. Used to build signed download links.
PUBLIC_API_URL=http://localhost:3000

# --- Supabase Storage (free tier, replaces Azure Blob) ---------------------
# Free 1 GB, no credit card. Project settings -> API.
# The SERVICE key bypasses row-level security and is as sensitive as the
# database password: host secret store only, never a client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=lih-documents

# --- Sentry (free tier, replaces Application Insights) ---------------------
SENTRY_DSN=

# ===========================================================================
# STORAGE
# ===========================================================================
# Policy certificates, claim evidence, receipts, identity documents.
# In AKS the pod authenticates to Blob with workload identity and this stays
# empty; the connection string is only for local development.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=lih-documents
LOCAL_STORAGE_PATH=./storage

# ===========================================================================
# NOTIFICATIONS
# ===========================================================================
# --- Email (SMTP / Azure Communication Services) ---------------------------
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lawyers Insurance Hub <no-reply@lih.cm>"
SMTP_SECURE=true

# --- SMS (Cameroonian aggregator) ------------------------------------------
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=LIH

# --- WhatsApp Business (Phase 2) -------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Push (Firebase / APNs via Azure Notification Hubs) --------------------
FIREBASE_SERVER_KEY=
AZURE_NOTIFICATION_HUB_CONNECTION=
AZURE_NOTIFICATION_HUB_NAME=

# ===========================================================================
# AI (Phase 2)
# ===========================================================================
# The AI features — claims fraud scoring, premium recommendation, the
# bilingual assistant and document classification — were architected on the
# Claude API. See blueprint §5.5.
ANTHROPIC_API_KEY=

# Not used. Present only because it was requested; if a future component needs
# OpenAI, add it deliberately rather than leaving a live key unused.
OPENAI_API_KEY=

# --- Azure AI Document Intelligence (OCR) ----------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ===========================================================================
# OBSERVABILITY
# ===========================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=debug                      # error | warn | log | debug | verbose
SENTRY_DSN=

# ===========================================================================
# BAR ASSOCIATION INTEGRATION
# ===========================================================================
# Directory sync. Until the API agreement is signed, verification runs off the
# manual queue in the Bar portal and this stays empty.
BAR_REGISTRY_API_URL=
BAR_REGISTRY_API_KEY=
BAR_VERIFICATION_SLA_HOURS=24
